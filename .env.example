# Local defaults. Copy to .env for convenience.
VKS_HOST=127.0.0.1
VKS_PORT=7870
VKS_PASSWORD=

# auto | codex | openai | mock
VKS_AI_PROVIDER=auto
VKS_AI_TIMEOUT=180

# Codex CLI mode
VKS_CODEX_EXE=codex

# Any OpenAI-compatible /chat/completions endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
VKS_MODEL=gpt-4.1-mini

# Optional paths
# VKS_PACKS=./packs
# VKS_DATA=./data
# VKS_FFMPEG=ffmpeg

# Video production voice
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
VKS_EDGE_TTS_RATE=+5%
VKS_TTS_SPEED=1.08
# For MiniMax, set TTS_PROVIDER=minimax and configure the key outside the repository:
# TTS_VOICE=female-yujie
# MINIMAX_KEY_FILE=/absolute/path/to/minimax.key
# MINIMAX_API_KEY can be used instead of MINIMAX_KEY_FILE
